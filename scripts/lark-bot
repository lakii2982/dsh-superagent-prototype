#!/usr/bin/env python3
"""Bot-only facade over an existing lark-cli login; never changes the personal CLI policy or credentials."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def main():
    real_cli = os.environ.get('DSH_SUPERAGENT_LARK_CLI') or shutil.which('lark-cli')
    if not real_cli or Path(real_cli).resolve() == Path(__file__).resolve():
        sys.exit('Set DSH_SUPERAGENT_LARK_CLI to the real lark-cli executable')
    args = sys.argv[1:]
    if args[:2] == ['config', 'strict-mode'] and len(args) == 2:
        print('strict-mode: bot (source: bot-only facade)')
        return
    if args[:2] == ['auth', 'status'] and all(arg in ['--json', '--verify'] for arg in args[2:]):
        command = [real_cli, 'auth', 'status', '--json'] + (['--verify'] if '--verify' in args else [])
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode:
            sys.stderr.write(result.stderr)
            sys.exit(result.returncode)
        status = json.loads(result.stdout)
        status['identities'] = {'bot': status.get('identities', {}).get('bot', {})}
        status['identity'] = 'bot'
        print(json.dumps(status))
        return
    if not args or args[0] not in ['im', 'api', 'event'] or (args[0] == 'event' and args[1:2] != ['consume']):
        sys.exit('This facade permits only bot IM/API/event commands and read-only auth status')
    filtered = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == '--as':
            if index + 1 >= len(args) or args[index + 1] != 'bot':
                sys.exit('Only bot identity is allowed')
            index += 2
        elif arg.startswith('--as='):
            if arg != '--as=bot':
                sys.exit('Only bot identity is allowed')
            index += 1
        else:
            filtered.append(arg)
            index += 1
    os.execv(real_cli, [real_cli, *filtered, '--as', 'bot'])


if __name__ == '__main__':
    main()
